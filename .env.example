# Public origin used for canonical URLs, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://your-production-domain.example"

# Contact address rendered in the footer. Leave empty to omit the affordance
# entirely (a control ships only when its consequence works — ARCHITECTURE §8).
NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional analytics beacon for Web Vitals; empty means no telemetry is sent.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""
